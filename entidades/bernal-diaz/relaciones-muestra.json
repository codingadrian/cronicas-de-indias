    {"from": "person:bernal-diaz-del-castillo", "relation": "viajó_a", "to": "place:tonala", "notas": "aquí sembró las primeras semillas de naranjo de la Nueva España", "source": "source:bernal-diaz:cap-16", "status": "candidata"},
    {"from": "person:juan-de-grijalva", "relation": "viajó_a", "to": "place:santiago-de-cuba", "notas": "regreso de la expedición, con unos veinte mil pesos de oro en total", "source": "source:bernal-diaz:cap-16", "status": "candidata"},
