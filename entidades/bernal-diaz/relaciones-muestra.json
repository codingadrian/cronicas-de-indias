    {"from": "person:juan-de-grijalva", "relation": "viajó_a", "to": "place:san-juan-de-ulua", "notas": "aquí se le dio el nombre por ser capitán Juan y día de San Juan", "source": "source:bernal-diaz:cap-14", "status": "candidata"},
