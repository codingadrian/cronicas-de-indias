    {"from": "person:francisco-de-montejo", "relation": "estuvo_presente_en", "to": "event:encuentro-rio-banderas-1518", "notas": "desembarcó primero con los ballesteros y escopeteros a explorar", "source": "source:bernal-diaz:cap-13", "status": "candidata"},
    {"from": "person:juan-de-grijalva", "relation": "estuvo_presente_en", "to": "event:encuentro-rio-banderas-1518", "notas": "recibió el presente de oro de los gobernadores de Moctezuma", "source": "source:bernal-diaz:cap-13", "status": "candidata"},
    {"from": "person:diego-velazquez-de-cuellar", "relation": "estuvo_presente_en", "to": "event:encuentro-rio-banderas-1518", "notas": "se tomó posesión de la tierra en su nombre como gobernador de Cuba", "source": "source:bernal-diaz:cap-13", "status": "candidata"},
    {"from": "person:francisco-indio-rio-banderas", "relation": "estuvo_presente_en", "to": "event:encuentro-rio-banderas-1518", "notas": "tomado y bautizado aquí; Bernal Díaz lo volvió a ver después casado en Santa Fe", "source": "source:bernal-diaz:cap-13", "status": "candidata"},
