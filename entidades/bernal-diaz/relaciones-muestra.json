    {"from": "person:juan-de-grijalva", "relation": "viajó_a", "to": "place:rio-tabasco", "notas": "el río se renombró 'de Grijalva' por haberlo descubierto él", "source": "source:bernal-diaz:cap-11", "status": "candidata"},
    {"from": "person:melchorejo", "relation": "estuvo_presente_en", "to": "event:expedicion-grijalva-1518", "notas": "sirvió de intérprete en el encuentro con los indios del río de Tabasco", "source": "source:bernal-diaz:cap-11", "status": "candidata"},
    {"from": "person:julianillo", "relation": "estuvo_presente_en", "to": "event:expedicion-grijalva-1518", "notas": "sirvió de intérprete en el encuentro con los indios del río de Tabasco", "source": "source:bernal-diaz:cap-11", "status": "candidata"},

