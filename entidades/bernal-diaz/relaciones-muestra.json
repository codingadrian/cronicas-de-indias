    {"from": "person:pedro-de-alvarado", "relation": "viajó_a", "to": "place:santiago-de-cuba", "notas": "llegó con el oro rescatado; Diego Velázquez celebró varios días", "source": "source:bernal-diaz:cap-15", "status": "candidata"},

