    {"from": "person:pedro-de-alvarado", "relation": "viajó_a", "to": "place:rio-de-alvarado", "notas": "se adelantó a la armada sin licencia; el general se enojó con él por esto", "source": "source:bernal-diaz:cap-12", "status": "candidata"},
    {"from": "person:juan-de-grijalva", "relation": "viajó_a", "to": "place:guacacualco", "notas": "vio el paraje del río pero no entró por mal tiempo", "source": "source:bernal-diaz:cap-12", "status": "candidata"},

