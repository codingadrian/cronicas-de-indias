    {"from": "person:juan-de-grijalva", "relation": "viajó_a", "to": "place:isla-de-sacrificios", "notas": "encontró indicios de sacrificios humanos recientes", "source": "source:bernal-diaz:cap-13", "status": "candidata"},
    {"from": "person:francisco-lopez-de-gomara", "relation": "estuvo_presente_en", "to": "event:encuentro-rio-banderas-1518", "notas": "Bernal Díaz corrige aquí una versión de Gómara/Oviedo sobre el origen del oro rescatado", "source": "source:bernal-diaz:cap-13", "status": "candidata"},

